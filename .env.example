# ── Database (local Docker Postgres or Supabase) ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investflow

# ── Supabase (use hosted project or local Supabase CLI) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
# Optional only for legacy Supabase HS256 JWT projects. JWKS is used by default.
SUPABASE_JWT_SECRET=

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Screener ─────────────────────────────────────────────────────────────────
SCREENER_CRON_HOUR=6
SCREENER_CRON_MINUTE=0
SCREENER_MIN_MARKET_CAP=1_000_000_000
# Sector-aware score threshold and maximum number sent to AI research.
SCREENER_MIN_SCORE=55
SCREENER_MIN_CONFIDENCE=60
SCREENER_TOP_N_CANDIDATES=20
# Legacy settings retained for compatibility; no longer universal hard filters.
SCREENER_MAX_PE=25
SCREENER_MIN_ROE=0.15

# ── Frontend / Backend URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000
